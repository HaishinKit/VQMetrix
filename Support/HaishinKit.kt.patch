diff --git a/haishinkit/src/test/java/com/haishinkit/codec/VideoCodecRawInputTest.kt b/haishinkit/src/test/java/com/haishinkit/codec/VideoCodecRawInputTest.kt
new file mode 100644
index 00000000..1c5abeb7
--- /dev/null
+++ b/haishinkit/src/test/java/com/haishinkit/codec/VideoCodecRawInputTest.kt
@@ -0,0 +1,36 @@
+package com.haishinkit.codec
+
+import android.media.MediaCodecInfo
+import com.haishinkit.graphics.PixelTransform
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, sdk = [29])
+class VideoCodecRawInputTest {
+    @Test
+    fun rawInputDoesNotCreateASurfaceRenderer() {
+        val previous = PixelTransform.factory
+        PixelTransform.factory = { throw AssertionError("Raw input must not allocate a renderer") }
+        val codec = VideoCodec(RuntimeEnvironment.getApplication())
+        try {
+            assertEquals(MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface, codec.inputColorFormat)
+            codec.inputColorFormat = MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420Flexible
+            codec.frameRate = 15
+            codec.isRunning.set(true)
+            assertThrows(IllegalStateException::class.java) {
+                codec.inputColorFormat = MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface
+            }
+            codec.isRunning.set(false)
+            codec.dispose()
+        } finally {
+            codec.isRunning.set(false)
+            PixelTransform.factory = previous
+        }
+    }
+}
