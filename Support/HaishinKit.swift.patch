diff --git a/HaishinKit/Sources/Codec/VideoCodecProbe.swift b/HaishinKit/Sources/Codec/VideoCodecProbe.swift
new file mode 100644
index 00000000..93bdb2f5
--- /dev/null
+++ b/HaishinKit/Sources/Codec/VideoCodecProbe.swift
@@ -0,0 +1,36 @@
+import AVFoundation
+
+/// Experimental adapter for external codec benchmarking tools.
+/// The caller must serialize access to each instance.
+@_spi(VideoQuality)
+public final class VideoCodecProbe {
+    private let codec = VideoCodec()
+
+    public var settings: VideoCodecSettings {
+        get { codec.settings }
+        set { codec.settings = newValue }
+    }
+
+    public var outputStream: AsyncStream<CMSampleBuffer> {
+        codec.outputStream
+    }
+
+    public init() {
+    }
+
+    public func append(_ sampleBuffer: CMSampleBuffer) {
+        codec.append(sampleBuffer)
+    }
+
+    public func startRunning() {
+        codec.startRunning()
+    }
+
+    public func finish() throws {
+        try codec.finish()
+    }
+
+    public func stopRunning() {
+        codec.stopRunning()
+    }
+}
