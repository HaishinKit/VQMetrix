<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:theme="@style/VQMetrixTheme" android:label="@string/vq_app_name"
        android:icon="@drawable/app_icon" android:allowBackup="false" android:usesCleartextTraffic="false"
        android:localeConfig="@xml/locales_config">
        <activity android:name="com.haishinkit.vqmetrix.VQMetrixActivity" android:exported="false" />
        <activity-alias android:name="com.haishinkit.vqmetrix.MainActivity"
            android:targetActivity="com.haishinkit.vqmetrix.VQMetrixActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
